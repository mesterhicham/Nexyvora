# Backend Environment Variables Template
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name
# Generate with: node -e "require('crypto').randomBytes(64, (e,b)=>console.log(b.toString('hex')))"
JWT_SECRET=use_a_strong_random_string_here
NODE_ENV=production
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# AI Support Assistant (Google Gemini API Key)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here


# Optional isolated database for the automated test suite (used when NODE_ENV=test)
DB_NAME_TEST=nexyvora_test

# Set to true ONLY when the API is served behind Cloudflare (enables the CF-IPCountry header)
TRUST_CF_IPCOUNTRY=false
